# openapi-typescript@7 peers on typescript ^5.x; this workspace runs TypeScript 6.
# The mismatch is accepted rather than hidden: downgrading the whole workspace's TypeScript
# for one browser-invisible codegen dev-dependency is the tail wagging the dog. The generated
# schema is committed and type-checked, so a genuine break in `npm run gen:api` is loud and
# immediate, never silent.
# Escape hatch if CI dislikes this flag: drop openapi-typescript from devDependencies and run
# `npx openapi-typescript@7` in the gen:api script instead.
legacy-peer-deps=true
